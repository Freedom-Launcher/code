{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freedom Launcher",
  "version": "0.1.0",
  "identifier": "io.github.freedomlauncher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Freedom Launcher",
        "width": 1100,
        "height": 700,
        "minWidth": 820,
        "minHeight": 540,
        "backgroundColor": "#0f1115",
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
