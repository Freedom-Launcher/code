{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freedom Launcher",
  "version": "0.3.1",
  "identifier": "io.github.freedomlauncher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Freedom Launcher",
        "width": 1100,
        "height": 700,
        "minWidth": 820,
        "minHeight": 540,
        "backgroundColor": "#0f1115",
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' theme: http://theme.localhost; img-src 'self' data: theme: http://theme.localhost wall: http://wall.localhost shot: http://shot.localhost https://cdn.modrinth.com; font-src 'self' theme: http://theme.localhost; connect-src ipc: http://ipc.localhost; frame-src addon: http://addon.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Freedom Launcher",
    "category": "Game",
    "shortDescription": "Лаунчер Minecraft: Java Edition",
    "longDescription": "Лёгкий и быстрый лаунчер Minecraft: Java Edition с темами, плагинами и модами с Modrinth.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Freedom Launcher"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDMTU2ODQ5RkUzOTZCMUIKUldRYmF6bitTV2dWdkVURSt5WVIrbW92MHQ0ZUljSU1jM3RsRkY1VUltRTNRVTZKd3lxcnlQQk8K",
      "endpoints": [
        "https://github.com/Freedom-Launcher/releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
