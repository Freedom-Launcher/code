{
  "id": "cyberpunk",
  "name": "Киберпанк",
  "version": "1.0.0",
  "author": "Freedom Launcher",
  "base": "dark",
  "tokens": {
    "--cp-magenta": "#ff2a6d",
    "--cp-cyan": "#05d9e8",
    "--cp-yellow": "#f9f871",
    "--bg": "#07060d",
    "--surface-1": "#0d0b17",
    "--surface-2": "#131022",
    "--surface-3": "#1b172e",
    "--hover": "rgba(5, 217, 232, .07)",
    "--press": "rgba(5, 217, 232, .12)",
    "--line": "rgba(255, 42, 109, .16)",
    "--line-strong": "rgba(255, 42, 109, .32)",
    "--text": "#ecfbff",
    "--text-2": "#93b9c8",
    "--text-3": "#5f6c86",
    "--accent": "#ff2a6d",
    "--accent-hover": "#ff4f87",
    "--accent-press": "#e01a5a",
    "--on-accent": "#14020b",
    "--accent-soft": "rgba(255, 42, 109, .15)",
    "--danger": "#ff4040",
    "--danger-soft": "rgba(255, 64, 64, .14)",
    "--warn": "#f9f871",
    "--focus-ring": "0 0 0 2px var(--bg), 0 0 0 4px #05d9e8",
    "--shadow-2": "0 10px 30px -10px rgba(255, 42, 109, .25)",
    "--shadow-pop": "0 0 0 1px rgba(5, 217, 232, .28), 0 20px 50px -14px rgba(0, 0, 0, .7), 0 0 34px -8px rgba(255, 42, 109, .35)",
    "--shadow-accent": "0 0 18px -2px rgba(255, 42, 109, .55)",
    "--font-display": "\"JetBrains Mono\", \"Cascadia Mono\", \"Consolas\", ui-monospace, monospace",
    "--tracking-title": ".01em",
    "--r-chip": "calc(2px * var(--rk-chip, 1))",
    "--r-control": "calc(3px * var(--rk-btn, 1))",
    "--r-card": "calc(4px * var(--rk-card, 1))",
    "--r-window": "calc(6px * var(--rk-dialog, 1))",
    "--glass": "rgba(10, 8, 22, var(--glass-a))",
    "--glass-strong": "rgba(12, 9, 26, .84)",
    "--glass-border": "rgba(5, 217, 232, .22)",
    "--glass-shadow": "0 24px 70px rgba(0, 0, 0, .45), 0 0 40px -12px rgba(255, 42, 109, .3)",
    "--wall-dim": "rgba(7, 6, 13, .45)"
  },
  "css": ["theme.css"]
}